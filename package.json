{
  "name": "cv-studio",
  "version": "1.0.1",
  "private": true,
  "main": "dist-electron/electron/main.js",
  "packageManager": "npm@10.9.8",
  "scripts": {
    "ng": "ng",
    "start": "npm run start:dev",
    "start:dev": "concurrently -k -n ng,electron -c blue,magenta \"npm run start:ng\" \"npm run start:electron\"",
    "start:ng": "npm run models && ng serve --host 127.0.0.1 --port 4200",
    "start:electron": "wait-on tcp:127.0.0.1:4200 && tsc -p tsconfig.electron.json && cross-env CV_DEV_SERVER_URL=http://127.0.0.1:4200 electron .",
    "models": "node scripts/fetch-translation-models.mjs",
    "build": "npm run models && ng build && tsc -p tsconfig.electron.json",
    "test": "tsc -p tsconfig.tests.json && node --test \"dist-tests/**/*.test.js\"",
    "dist:mac": "npm run build && electron-builder --mac --arm64",
    "dist:win": "npm run build && electron-builder --win --x64",
    "icons": "node scripts/generate-icons.mjs && capacitor-assets generate --android --ios --iconBackgroundColor '#2a55ad' --iconBackgroundColorDark '#2a55ad' --splashBackgroundColor '#1f4288' --splashBackgroundColorDark '#0e1015'",
    "build:mobile": "npm run build && cap sync",
    "android": "npm run build:mobile && cap run android",
    "android:apk": "npm run build:mobile && cd android && ./gradlew assembleDebug",
    "ios": "npm run build:mobile && cap run ios"
  },
  "devDependencies": {
    "@angular/build": "^22.0.4",
    "@angular/cdk": "^22.0.2",
    "@angular/cli": "^22.0.4",
    "@angular/common": "^22.0.0",
    "@angular/compiler": "^22.0.0",
    "@angular/compiler-cli": "^22.0.0",
    "@angular/core": "^22.0.0",
    "@angular/forms": "^22.0.0",
    "@angular/platform-browser": "^22.0.0",
    "@angular/router": "^22.0.0",
    "@capacitor/android": "^8.6.2",
    "@capacitor/assets": "^4.0.0",
    "@capacitor/cli": "^8.6.2",
    "@capacitor/core": "^8.6.2",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/ios": "^8.6.2",
    "@capacitor/share": "^8.0.3",
    "@fontsource/comic-neue": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/libre-baskerville": "^5.3.0",
    "@fontsource/lora": "^5.3.0",
    "@fontsource/source-sans-3": "^5.2.8",
    "@fontsource/source-serif-4": "^5.3.0",
    "@mkljczk/bergamot-translator": "^0.4.16",
    "@types/node": "^22.19.0",
    "concurrently": "^9.2.1",
    "cross-env": "^10.0.0",
    "electron": "^44.5.1",
    "electron-builder": "^26.16.1",
    "i18n-iso-countries": "^7.14.0",
    "prettier": "^3.8.1",
    "rxjs": "~7.8.0",
    "tslib": "^2.8.1",
    "typescript": "~6.0.2",
    "wait-on": "^8.0.5",
    "zone.js": "~0.15.1"
  }
}
